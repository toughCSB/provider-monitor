    "Sign out in the %@ window to use another account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich im %@-Fenster ab, um ein anderes Konto zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous dans la fenêtre %@ pour utiliser un autre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントを使うには、%@ のウインドウでサインアウトしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정을 사용하려면 %@ 창에서 로그아웃합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia na janela do %@ para usar outra conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите из аккаунта в окне %@, чтобы использовать другой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вийдіть у вікні %@, щоб використати інший акаунт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 窗口里退出，才能换另一个账号。"
          }
        }
      }
    },
    "Signed out — nothing is read, and no readings are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgemeldet — es wird nichts gelesen, und es werden keine Messwerte behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté — rien n'est lu, et aucun relevé n'est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウト済み — 読み取りも行わず、読み取りの保存もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃됨 — 아무것도 읽지 않으며 측정값도 보관하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado — nada é lido, e nenhuma leitura é mantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход выполнен — данные не читаются и не сохраняются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вийшли — нічого не зчитується, показники не зберігаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出 — 不再读取，也不再保存读数。"
          }
        }
      }
    },
    "Signs out of %@ — the session belongs to Codenotch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich bei %@ ab — die Sitzung gehört Codenotch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte de %@ — la session appartient à Codenotch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からサインアウトします — このセッションは Codenotch のものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 로그아웃합니다. 이 세션은 Provider Monitor에 속합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai do %@ — a sessão pertence ao Codenotch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход из %@ — сессия принадлежит Codenotch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід із %@ — сесія належить Codenotch."
