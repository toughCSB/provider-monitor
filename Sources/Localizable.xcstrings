    "Done": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Down the left-hand edge, clear of a Dock on that side.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am linken Rand entlang, mit Abstand zu einem Dock auf dieser Seite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le long du bord gauche, à l'écart d'un Dock placé de ce côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左端に沿って。その側の Dock は避けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 Dock을 피해 화면 왼쪽 가장자리에 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao longo da borda esquerda, livre de um Dock desse lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вдоль левого края, не занимая место у Dock."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уздовж лівого краю, не перекриваючи Dock, якщо він з того боку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿左边缘，避开那一侧的程序坞。"
          }
        }
      }
    },
    "Down the right-hand edge, clear of a Dock on that side.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am rechten Rand entlang, mit Abstand zu einem Dock auf dieser Seite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le long du bord droit, à l'écart d'un Dock placé de ce côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右端に沿って。その側の Dock は避けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 Dock을 피해 화면 오른쪽 가장자리에 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao longo da borda direita, livre de um Dock desse lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вдоль правого края, не занимая место у Dock."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уздовж правого краю, не перекриваючи Dock, якщо він з того боку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿右边缘，避开那一侧的程序坞。"
          }
        }
      }
    },
    "Drag the notch to slide it along its edge — or hold ⌥, which has always done the same. Each edge remembers where you left it.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 드래그하면 화면 가장자리를 따라 이동합니다. ⌥를 누른 채 드래그해도 같은 동작입니다. 가장자리마다 위치를 기억합니다."
          }
        }
      }
    },
    "Drag to reorder the rings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um die Ringe neu anzuordnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner les anneaux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグでリングを並べ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 링 순서 변경"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar os anéis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок колец"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок кілець"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重排圆环"
          }
        }
      }
    },
    "Drag to reorder. The notch draws the rings in this order.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um die Reihenfolge zu ändern. Die Notch zeichnet die Ringe in dieser Reihenfolge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. L'encoche dessine les anneaux dans cet ordre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。ノッチはこの順にリングを描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경합니다. 노치가 이 순서대로 링을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. O notch desenha os anéis nesta ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Панель отображает кольца в этом порядке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок. Виріз показує кільця саме в цьому порядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以改顺序。刘海按这个顺序画圆环。"
          }
        }
      }
    },
    "Each display gets its own notch, and hovering one opens only that one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Bildschirm bekommt seine eigene Notch, und Hover öffnet jeweils nur diese eine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écran a sa propre encoche, et en survoler une n'ouvre que celle-là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイごとに独自のノッチが出ます。ホバーしたものだけが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디스플레이에 별도의 노치가 표시되며, 호버한 노치만 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tela ganha o próprio notch, e passar o cursor sobre um abre somente aquele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На каждом дисплее есть своя панель, и наведение открывает только её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен дисплей отримує власний виріз, і наведення відкриває лише його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个显示器各有一个刘海，悬停只会打开那一个。"
          }
        }
      }
    },
    "Each loaded model gets its own cell, with the tokens per second of its last response and a mark while it is thinking. The measurement is taken locally and nothing about a prompt leaves the machine.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로드된 모델마다 별도 셀에 마지막 응답의 초당 토큰 수와 추론 중 표시를 보여 줍니다. 측정은 로컬에서 이루어지며 프롬프트에 관한 어떤 정보도 Mac 밖으로 나가지 않습니다."
          }
        }
      }
    },
    "Each read from the tool already signed in on this Mac. Codenotch never asks for a password.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder wird aus dem Tool gelesen, das auf diesem Mac bereits angemeldet ist. Codenotch fragt nie nach einem Passwort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun lu depuis l'outil déjà connecté sur ce Mac. Codenotch ne demande jamais de mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いずれもこの Mac ですでにサインイン済みのツールから読み取ります。Codenotch がパスワードを尋ねることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사용량은 이 Mac에 이미 로그인된 도구에서 읽습니다. Provider Monitor는 암호를 요구하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um lido da ferramenta já conectada neste Mac. O Codenotch nunca pede uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные читаются из уже авторизованного на этом Mac инструмента. Codenotch никогда не спрашивает пароль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен зчитується з інструмента, у якому вже виконано вхід на цьому Mac. Codenotch ніколи не запитує пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各自读取这台 Mac 上已经登录的工具。Codenotch 从不问密码。"
          }
        }
      }
    },
    "Each read from the tool already signed in on this Mac. Provider Monitor never asks for a password.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder wird aus dem Tool gelesen, das auf diesem Mac bereits angemeldet ist. Provider Monitor fragt nie nach einem Passwort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun lu depuis l'outil déjà connecté sur ce Mac. Provider Monitor ne demande jamais de mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いずれもこの Mac ですでにサインイン済みのツールから読み取ります。Provider Monitor がパスワードを尋ねることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사용량은 이 Mac에 이미 로그인된 도구에서 읽습니다. Provider Monitor는 암호를 요구하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um lido da ferramenta já conectada neste Mac. O Provider Monitor nunca pede uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные читаются из уже авторизованного на этом Mac инструмента. Provider Monitor никогда не спрашивает пароль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен зчитується з інструмента, у якому вже виконано вхід на цьому Mac. Provider Monitor ніколи не запитує пароль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各自读取这台 Mac 上已经登录的工具。Provider Monitor 从不问密码。"
          }
        }
      }
    },
    "Easier to read at a glance, and harder to ignore.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einen Blick leichter zu lesen, und schwerer zu übersehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus facile à lire d'un coup d'œil, et plus difficile à ignorer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと目で読みやすく、無視しにくいサイズ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한눈에 읽기 쉽고 눈에 더 잘 띕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais fácil de ler de relance, e mais difícil de ignorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легче читать одним взглядом, но сложнее не заметить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легше прочитати одним поглядом і важче не помітити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼更好读，也更难忽视。"
          }
        }
      }
    },
