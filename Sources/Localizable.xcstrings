    },
    "Asks macOS for %@'s saved login again. Choose Always Allow and it will stop asking.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt macOS erneut nach der gespeicherten Anmeldung von %@. Wähle „Immer erlauben“, damit nicht mehr nachgefragt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemande à macOS les identifiants enregistrés de %@. Choisissez Toujours autoriser et il cessera de demander."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の保存済みログインを macOS に再度要求します。「常に許可」を選べば以後は尋ねられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에 %@의 저장된 로그인 접근을 다시 요청합니다. ‘항상 허용’을 선택하면 더 이상 묻지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede novamente ao macOS o login salvo do %@. Escolha Sempre Permitir e ele deixará de perguntar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно запрашивает у macOS сохранённый вход %@. Выберите «Разрешать всегда», чтобы больше не видеть этот запрос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову запитує в macOS збережений вхід %@. Виберіть «Завжди дозволяти» — і запити припиняться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次向 macOS 请求 %@ 已保存的登录信息。选「始终允许」就不会再问。"
          }
        }
      }
    },
    "Asks macOS for %@'s saved login again. Deny stops Codenotch reading it until you ask again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt macOS erneut nach der gespeicherten Anmeldung von %@. „Ablehnen“ verhindert, dass Codenotch sie liest, bis du erneut fragst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemande à macOS la connexion enregistrée de %@. Refuser empêche Codenotch de la lire jusqu'à ce que vous redemandiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の保存済みログインをもう一度 macOS に求めます。「拒否」を選ぶと、もう一度求めるまで Codenotch はそれを読みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에 %@의 저장된 로그인을 다시 요청합니다. ‘거부’를 선택하면 다시 요청할 때까지 Provider Monitor가 이를 읽지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede de novo ao macOS o login salvo de %@. Negar impede o Codenotch de lê-lo até você pedir de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова запрашивает у macOS сохранённый вход %@. «Запретить» не даёт Codenotch читать его, пока вы не спросите снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову запитує в macOS збережений вхід %@. «Заборонити» не дає Codenotch читати його, доки ви не запитаєте знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次向 macOS 请求 %@ 保存的登录信息。选择“拒绝”后，在你再次请求之前 Codenotch 不会读取它。"
          }
        }
      }
    },
    "Asks macOS for %@'s saved login again. Deny stops Provider Monitor reading it until you ask again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에 %@의 저장된 로그인을 다시 요청합니다. ‘거부’를 선택하면 다시 요청할 때까지 Provider Monitor가 이를 읽지 않습니다."
          }
        }
      }
    },
