          }
        }
      }
    },
    "Tells you when a limit resets or runs out, speaks Russian, and reads Kimi.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도가 재설정되거나 소진될 때 알리고 러시아어를 지원하며 Kimi 사용량을 읽습니다."
          }
        }
      }
    },
    "Terminal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        }
      }
    },
    "That display is disconnected. Codenotch follows the active window until it returns.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm ist getrennt. Codenotch folgt dem aktiven Fenster, bis er zurückkommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran est déconnecté. Codenotch suit la fenêtre active jusqu'à son retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのディスプレイは接続されていません。復帰するまで、Codenotch はアクティブなウインドウに追従します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 디스플레이의 연결이 끊겼습니다. 다시 연결될 때까지 Provider Monitor가 활성 윈도우를 따라갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa tela está desconectada. O Codenotch acompanha a janela ativa até ela voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот дисплей отключён. Codenotch следует за активным окном, пока дисплей не вернётся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей дисплей відʼєднано. Codenotch стежить за активним вікном, доки дисплей не повернеться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那台显示器已断开。Codenotch 会跟随活动窗口，直到它回来。"
          }
        }
      }
    },
    "That display is disconnected. Provider Monitor follows the active window until it returns.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm ist getrennt. Provider Monitor folgt dem aktiven Fenster, bis er zurückkommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran est déconnecté. Provider Monitor suit la fenêtre active jusqu'à son retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのディスプレイは接続されていません。復帰するまで、Provider Monitor はアクティブなウインドウに追従します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 디스플레이의 연결이 끊겼습니다. 다시 연결될 때까지 Provider Monitor가 활성 윈도우를 따라갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa tela está desconectada. O Provider Monitor acompanha a janela ativa até ela voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот дисплей отключён. Provider Monitor следует за активным окном, пока дисплей не вернётся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей дисплей відʼєднано. Provider Monitor стежить за активним вікном, доки дисплей не повернеться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那台显示器已断开。Provider Monitor 会跟随活动窗口，直到它回来。"
          }
        }
      }
    },
    "The %@ plan has nothing for Cursor to meter yet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der %@-Tarif hat für Cursor noch nichts zu messen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan %@ n'a encore rien à mesurer pour Cursor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ プランには、Cursor が計測できる対象がまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 요금제에는 아직 Cursor가 측정할 항목이 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano %@ ainda não tem nada para o Cursor medir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В тарифе %@ пока нечего измерять для Cursor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У тарифі %@ поки немає чого вимірювати для Cursor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 套餐目前还没有可供 Cursor 计量的额度"
          }
        }
      }
    },
    "The account's plan under the title, and Codex rate-limit resets you have not used yet.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 아래에 계정 요금제를 표시하고 아직 사용하지 않은 Codex 사용량 한도 재설정을 보여 줍니다."
          }
        }
      }
    },
    "The arc above the notch. Hold it to carry the notch to another edge — Edge above does the same.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチの上にある弧です。長押しすると、ノッチを別の辺へ運べます。上の「配置する辺」でも同じことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 위의 호입니다. 길게 눌러 노치를 다른 가장자리로 옮길 수 있으며, 위의 ‘가장자리’ 설정으로도 같은 작업을 할 수 있습니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга над вирізом. Утримуйте її, щоб перенести виріз на інший край — те саме робить «Край» вище."
          }
        }
      }
    },
    "The automatic fold over full-screen apps can now be switched off, for anyone whose maximised windows kept folding the notch.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대화된 창 때문에 노치가 계속 접히는 경우 전체 화면 앱에서 자동 접기를 끌 수 있습니다."
          }
        }
      }
    },
    "The check follows the original Codenotch app's update feed, so it reports what upstream has shipped. Installing from that feed would replace this build with the original app, so Provider Monitor never does.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung folgt dem Feed der ursprünglichen Codenotch-App und meldet nur, was Upstream veröffentlicht hat. Eine Installation aus diesem Feed würde diesen Build durch die Original-App ersetzen, deshalb tut Provider Monitor das nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification suit le flux de l'app Codenotch d'origine : elle signale ce que l'amont a publié. Installer depuis ce flux remplacerait cette version par l'app d'origine, donc Provider Monitor ne le fait jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート確認はオリジナルのCodenotchアプリのフィードを参照し、上流が公開した内容を伝えるだけです。そのフィードからインストールするとこのビルドがオリジナルアプリに置き換わるため、Provider Monitorはインストールしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인은 원본 코드노치 앱의 피드를 따르므로 원본이 배포한 내용을 알려줄 뿐입니다. 그 피드에서 설치하면 이 빌드가 원본 앱으로 바뀌기 때문에 Provider Monitor는 설치하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação segue o feed do app Codenotch original, então apenas informa o que o upstream publicou. Instalar por esse feed substituiria esta versão pelo app original, e o Provider Monitor nunca faz isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка идёт по ленте оригинального приложения Codenotch и только сообщает, что выпустил upstream. Установка из этой ленты заменила бы эту сборку оригинальным приложением, поэтому Provider Monitor так не делает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка йде за стрічкою оригінального застосунку Codenotch і лише повідомляє, що випустив upstream. Встановлення з цієї стрічки замінило б цю збірку оригінальним застосунком, тому Provider Monitor цього ніколи не робить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查遵循原始 Codenotch 应用的更新源，只报告上游发布了什么。从该更新源安装会用原始应用替换当前构建，因此 Provider Monitor 不会这样做。"
          }
        }
      }
    },
    "The Codex reading no longer re-parses a whole rollout on every poll, which is what made the hover card late.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 사용량을 읽을 때마다 롤아웃 전체를 다시 파싱하지 않습니다. hover 카드가 늦게 뜨던 원인이었습니다."
          }
        }
      }
    },
    "The Codex ring notices the desktop app": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Codex-Ring bemerkt jetzt die Desktop-App"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anneau Codex remarque l'app de bureau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex のリングがデスクトップアプリを認識"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 링이 데스크톱 앱 감지"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel do Codex percebe o app para desktop"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо Codex видит настольное приложение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце Codex помічає десктопний застосунок"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 圆环会注意到桌面应用"
          }
        }
      }
    },
    "The device accent by default, or a fixed colour for the ring's positive state — the amber and red warning colours stay fixed regardless.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig die Geräte-Akzentfarbe, oder eine feste Farbe für den positiven Zustand des Rings — die Warnfarben Gelb und Rot bleiben in jedem Fall fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accentuation de l'appareil par défaut, ou une couleur fixe pour l'état positif de l'anneau — les couleurs d'alerte ambre et rouge restent fixes quoi qu'il arrive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定ではデバイスのアクセントカラー。リングの正常時の色を固定することもできます。警告のアンバーと赤は、いずれの場合も固定のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 기기 강조 색상이며 링의 정상 상태에 고정 색상을 선택할 수도 있습니다. 황색과 빨간색 경고 색상은 항상 고정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor de destaque do dispositivo por padrão, ou uma cor fixa para o estado positivo do anel — as cores de aviso âmbar e vermelha permanecem fixas de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию используется акцент устройства или фиксированный цвет положительного состояния кольца; янтарный и красный цвета предупреждений не меняются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово — акцентний колір пристрою або фіксований колір позитивного стану кільця; бурштиновий і червоний кольори попередження в будь-якому разі лишаються незмінними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认用设备强调色，也可以给圆环的正常状态固定一个颜色 — 琥珀和红色警告色始终不变。"
          }
        }
      }
    },
    "The figure came from a file Codex writes during a turn, so it was as old as the last time you used it — three days stale in one case. Codenotch now asks Codex itself, and matches its own panel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl stammte aus einer Datei, die Codex während eines Turns schreibt, war also so alt wie deine letzte Nutzung — in einem Fall drei Tage veraltet. Codenotch fragt jetzt Codex selbst und stimmt mit dessen eigenem Panel überein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre venait d'un fichier que Codex écrit pendant un tour : il datait donc de votre dernière utilisation — trois jours de retard dans un cas. Codenotch interroge désormais Codex lui-même, et correspond à son propre panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はターンの途中で Codex が書き出すファイルから取っていたため、最後に使った時点のまま古くなっていました。3 日前の値だったこともあります。今は Codex 自身に問い合わせるので、Codex のパネルと一致します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값은 Codex가 작업 중 기록하는 파일에서 가져와 마지막 사용 시점만큼 오래될 수 있었으며, 한 사례에서는 3일 전 값이었습니다. 이제 Provider Monitor가 Codex에 직접 요청하여 자체 패널과 같은 값을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número vinha de um arquivo que o Codex escreve durante um turno, então era tão antigo quanto a última vez que você o usou — três dias desatualizado em um caso. Agora o Codenotch pergunta ao próprio Codex, e bate com o painel dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число бралась из файла, который Codex записывает во время хода, поэтому могло устареть на несколько дней. Теперь Codenotch спрашивает сам Codex и показывает данные его панели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число бралося з файлу, який Codex записує під час ходу, тож воно було старим рівно настільки, наскільки давно ви ним користувалися — в одному випадку застаріле на три дні. Тепер Codenotch питає сам Codex і збігається з його власною панеллю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字来自 Codex 在一轮对话里写的文件，所以有多旧取决于你上次用它是什么时候 — 有一次旧了三天。Codenotch 现在直接问 Codex，并与它自己的面板一致。"
          }
        }
      }
    },
    "The figure came from a file Codex writes during a turn, so it was as old as the last time you used it — three days stale in one case. Provider Monitor now asks Codex itself, and matches its own panel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl stammte aus einer Datei, die Codex während eines Turns schreibt, war also so alt wie deine letzte Nutzung — in einem Fall drei Tage veraltet. Provider Monitor fragt jetzt Codex selbst und stimmt mit dessen eigenem Panel überein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre venait d'un fichier que Codex écrit pendant un tour : il datait donc de votre dernière utilisation — trois jours de retard dans un cas. Provider Monitor interroge désormais Codex lui-même, et correspond à son propre panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値はターンの途中で Codex が書き出すファイルから取っていたため、最後に使った時点のまま古くなっていました。3 日前の値だったこともあります。今は Codex 自身に問い合わせるので、Codex のパネルと一致します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값은 Codex가 작업 중 기록하는 파일에서 가져와 마지막 사용 시점만큼 오래될 수 있었으며, 한 사례에서는 3일 전 값이었습니다. 이제 Provider Monitor가 Codex에 직접 요청하여 자체 패널과 같은 값을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número vinha de um arquivo que o Codex escreve durante um turno, então era tão antigo quanto a última vez que você o usou — três dias desatualizado em um caso. Agora o Provider Monitor pergunta ao próprio Codex, e bate com o painel dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число бралась из файла, который Codex записывает во время хода, поэтому могло устареть на несколько дней. Теперь Provider Monitor спрашивает сам Codex и показывает данные его панели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число бралося з файлу, який Codex записує під час ходу, тож воно було старим рівно настільки, наскільки давно ви ним користувалися — в одному випадку застаріле на три дні. Тепер Provider Monitor питає сам Codex і збігається з його власною панеллю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字来自 Codex 在一轮对话里写的文件，所以有多旧取决于你上次用它是什么时候 — 有一次旧了三天。Provider Monitor 现在直接问 Codex，并与它自己的面板一致。"
          }
        }
      }
    },
    "The first release.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のリリース。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 릴리스입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый выпуск."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший випуск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首个版本。"
          }
        }
      }
    },
    "The headline ring can follow a named limit rather than whichever happens to be tightest, and a CLI-only install counts as a real account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptring kann einem bestimmten Limit folgen, statt automatisch dem knappsten, und eine reine CLI-Installation zählt jetzt als echtes Konto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主リングを、たまたま最も逼迫している上限ではなく、指定した上限に従わせられます。また CLI だけのインストールも実アカウントとして扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 링이 가장 빠듯한 한도 대신 지정한 한도를 따르도록 설정할 수 있으며, CLI 전용 설치도 실제 계정으로 인식합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основное кольцо может следовать выбранному лимиту, а не самому строгому, и установка только через CLI считается полноценным аккаунтом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Головне кільце може стежити за конкретним лімітом, а не за найтіснішим на цю мить, а встановлення лише через CLI вважається справжнім акаунтом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主圆环可以跟着指定的额度走，而不一定是最紧的那项；只有 CLI 的安装也算真实账号。"
          }
        }
      }
    },
    "The hover card lists Spark and code review when your account has them, and Appearance can hide them.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에서 사용할 수 있는 경우 호버 카드에 Spark 및 코드 리뷰를 표시하며, 모양에서 숨길 수 있습니다."
          }
        }
      }
    },
    "The keychain password stops coming back": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되던 키체인 암호 요청 해결"
          }
        }
      }
    },
    "The list was capped at four whatever you were running on. It is now solved for the display: ten on a large one, and \"and N more\" only when there is genuinely no room for the rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste war bisher unabhängig vom Gerät auf vier begrenzt. Jetzt richtet sie sich nach dem Bildschirm: zehn auf einem großen, und „und N weitere“ nur, wenn für den Rest wirklich kein Platz ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste était plafonnée à quatre quel que soit votre matériel. Elle est désormais calculée pour l'écran : dix sur un grand, et « et N de plus » uniquement quand il n'y a vraiment plus de place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧は実行環境にかかわらず 4 件に固定されていました。今はディスプレイに合わせて決まります。大きな画面なら 10 件、「ほか N 件」は本当に余地がないときだけ出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경과 관계없이 목록이 4개로 제한되었습니다. 이제 디스플레이 크기에 맞춰 큰 화면에는 10개까지 표시하며, 실제로 공간이 부족할 때만 ‘외 N개’를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista era limitada a quatro, em qualquer tela. Agora ela é calculada para o monitor: dez em um grande, e \"e mais N\" apenas quando realmente não há espaço para o resto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раньше список всегда ограничивался четырьмя пунктами. Теперь он подстраивается под экран: до десяти на большом, а «и ещё N» появляется только при нехватке места."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список завжди обмежувався чотирма пунктами, хоч би на чому ви працювали. Тепер він розраховується під екран: десять на великому, а «і ще N» — лише коли для решти справді немає місця."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不论你在跑什么，列表以前最多四条。现在按屏幕算：大屏幕十条，只有真的放不下时才出现「还有 N 个」。"
          }
        }
      }
    },
    "The move handle lines up with the camera housing, and more of Settings is translated into Simplified Chinese.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 핸들을 카메라 하우징에 맞추고 더 많은 설정 문구를 중국어 간체로 번역했습니다."
          }
        }
      }
    },
    "The notch appears only on the display with the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch erscheint nur auf dem Bildschirm mit der Menüleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche n'apparaît que sur l'écran qui porte la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチはメニューバーのあるディスプレイにだけ出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치는 메뉴 막대가 있는 디스플레이에만 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch aparece apenas na tela que tem a barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель появляется только на дисплее со строкой меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз зʼявляється лише на дисплеї з рядком меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海只出现在有菜单栏的显示器上。"
          }
        }
      }
    },
    "The notch draws these in this order. Drag one by its handle to move it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch zeichnet diese in dieser Reihenfolge. Ziehe eines an seinem Griff, um es zu verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche les dessine dans cet ordre. Faites glisser une ligne par sa poignée pour la déplacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチはこの順にリングを描きます。ハンドルをドラッグして並べ替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치가 이 순서대로 표시합니다. 핸들을 드래그하여 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch desenha estes nesta ordem. Arraste um pela alça para movê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель отображает эти кольца в таком порядке. Перетащите кольцо за маркер, чтобы изменить порядок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз малює їх у цьому порядку. Перетягніть кільце за маркер, щоб перемістити його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海按这个顺序画。拖动一行的手柄即可改顺序。"
          }
        }
      }
    },
    "The notch floats above other windows. Off lets another application's windows cover it, as they cover each other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Notch schwebt über anderen Fenstern. Ausgeschaltet können Fenster anderer Programme ihn verdecken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche flotte au-dessus des autres fenêtres. Désactivé, les fenêtres des autres applications peuvent la recouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチは他のウインドウの上に浮かびます。オフにすると、他のアプリのウインドウがノッチを覆います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치는 다른 창 위에 떠 있습니다. 끄면 다른 앱의 창이 노치를 가릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recorte flutua sobre as outras janelas. Desativado, as janelas de outros aplicativos podem cobri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вырез отображается поверх других окон. Если выключить, окна других приложений смогут его перекрывать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз плаває над іншими вікнами. Вимкнено — вікна інших програм можуть його перекривати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海浮于其他窗口之上。关闭后，其他应用的窗口可以像遮盖彼此时一样遮住它。"
          }
        }
      }
    },
    "The notch folds away for a full-screen app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 앱에서 노치 접기"
          }
        }
      }
    },
    "The notch folds away while a full-screen app is frontmost, and returns when you leave it. Off keeps it in place over full-screen apps.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのアプリが前面にある間、ノッチは折りたたまれ、離れると戻ります。オフにすると、フルスクリーンのアプリの上でもそのまま表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 앱이 전면에 있을 때 노치가 접히고 전체 화면을 종료하면 돌아옵니다. 끄면 전체 화면 앱 위에도 노치가 그대로 유지됩니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз згортається, поки попереду повноекранний застосунок, і повертається, коли ви його залишите. Вимкнено — виріз лишається поверх повноекранних застосунків."
          }
        }
      }
    },
    "The notch is welded to the screen edge": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 가장자리에 노치 고정"
          }
        }
      }
    },
    "The notch opens itself for a few seconds and sounds a chime when an agent stops working or starts waiting on you; a click jumps to it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch öffnet sich von selbst für ein paar Sekunden und spielt einen Ton, wenn ein Agent aufhört zu arbeiten oder anfängt, auf dich zu warten; ein Klick springt dorthin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche s'ouvre quelques secondes et émet un son quand un agent cesse de travailler ou se met à vous attendre ; un clic vous y amène."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが作業を止めるか、あなたを待ち始めると、ノッチが数秒だけ開いてチャイムを鳴らします。クリックするとそこへ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 작업을 멈추거나 사용자 응답을 기다리기 시작하면 노치가 몇 초 동안 열리고 알림음이 재생됩니다. 클릭하면 해당 세션으로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch se abre por alguns segundos e toca um sinal sonoro quando um agente para de trabalhar ou começa a aguardar você; um clique leva até ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель открывается на несколько секунд и издаёт сигнал, когда агент завершает работу или начинает ждать вас; щелчок открывает сеанс."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз сам розкривається на кілька секунд і подає сигнал, коли агент завершує роботу або починає чекати на вас; клік відкриває цю сесію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手停止工作或开始等你时，刘海会自己打开几秒并响一声；点击会跳过去。"
          }
        }
      }
    },
    "The notch slides out a card the moment a provider's limit rolls over, and again when a session or weekly limit reaches 100%. Notifications in Settings chooses which of those you want, with an optional chime.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로바이더 한도가 재설정되는 순간과 세션 또는 주간 한도가 100%에 도달할 때 노치 옆으로 카드를 표시합니다. 설정의 알림에서 원하는 항목과 선택적 알림음을 지정할 수 있습니다."
          }
        }
      }
    },
    "The notch stays open with every reading visible.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch bleibt offen, mit allen Messwerten sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche reste ouverte, tous les relevés visibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチは開いたままで、すべての読み取りが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 측정값이 보이도록 노치를 계속 열어 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch fica aberto com todas as leituras visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выемка остаётся открытой, и все данные видны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз лишається відкритим, усі показники видно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海保持展开，所有读数都看得见。"
          }
        }
      }
    },
    "The number under each ring counts down as the limit is spent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl unter jedem Ring zählt herunter, während das Limit verbraucht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre sous chaque anneau diminue à mesure que la limite est consommée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リングの下の数字は、上限を使うほど減っていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 링 아래 숫자는 한도를 쓸수록 줄어듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número sob cada anel diminui conforme o limite é gasto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число под каждым кольцом уменьшается по мере расхода лимита."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число під кожним кільцем зменшується в міру витрати ліміту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个圆环下方的数字会随用量增加而减少。"
          }
        }
      }
    },
    "The number under each ring counts up as the limit is spent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl unter jedem Ring zählt herauf, während das Limit verbraucht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre sous chaque anneau augmente à mesure que la limite est consommée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リングの下の数字は、上限を使うほど増えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 링 아래 숫자는 한도를 쓸수록 늘어납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número sob cada anel aumenta conforme o limite é gasto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число под каждым кольцом растёт по мере расхода лимита."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число під кожним кільцем зростає в міру витрати ліміту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个圆环下方的数字会随用量增加而增加。"
          }
        }
      }
    },
    "The Ollama relay and the Windows event server now refuse browser requests from other sites, and raw responses are kept out of the system log. Reading DeepSeek also checks the page's address exactly, where a lookalike domain could have passed before.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 릴레이와 Windows 이벤트 서버는 이제 다른 사이트의 브라우저 요청을 거부하며 원시 응답을 시스템 로그에 남기지 않습니다. DeepSeek를 읽을 때 페이지 주소도 정확히 확인하여 유사 도메인이 통과하지 못하게 합니다."
          }
        }
      }
    },
    "The ones that need you come first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die, die dich brauchen, kommen zuerst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celles qui vous attendent passent en premier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたを待っているものが先頭に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 항목 우선"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As que precisam de você vêm primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала показываются те, кому вы нужны"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу ті, що чекають на вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你的排在前面"
          }
        }
      }
    },
    "The open notch, its tooltip and the settings orb take the system's own glass surface, so they refract what is behind them instead of sitting on it. Reduce Transparency turns it solid.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geöffnete Notch, ihr Tooltip und die Einstellungskugel nutzen die systemeigene Glasoberfläche, sodass sie brechen, was dahinterliegt, statt einfach darauf zu sitzen. „Transparenz reduzieren“ macht sie deckend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたノッチ、そのツールチップ、設定のオーブが、システム自身のガラス面を使います。背景の上に載るのではなく、背景を屈折させます。「透明度を下げる」をオンにすると不透明になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 노치, 툴팁 및 설정 구체가 시스템 유리 표면을 사용하여 뒤의 내용을 굴절시킵니다. ‘투명도 줄이기’를 켜면 불투명해집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытая панель, её подсказка и кнопка настроек используют системную стеклянную поверхность и преломляют фон. При уменьшении прозрачности они становятся сплошными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкритий виріз, його підказка і сфера налаштувань беруть системну скляну поверхню, тож заломлюють те, що позаду, а не просто лежать зверху. «Зменшити прозорість» робить їх непрозорими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开的刘海、提示卡和设置圆球用上系统自己的玻璃表面，折射背后的内容，而不是盖在上面。「降低透明度」会变成实心。"
          }
        }
      }
    },
    "The original app's feed has no newer version.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Feed der Original-App hat keine neuere Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux de l'app d'origine n'a pas de version plus récente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルアプリのフィードに新しいバージョンはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 앱 피드에 새 버전이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O feed do app original não tem versão mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ленте исходного приложения нет новой версии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У стрічці оригінального застосунку немає новішої версії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始应用的更新源没有新版本。"
          }
        }
      }
    },
    "The original opaque black notch. Always dark, whatever the Mac's appearance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche, deckend schwarze Notch. Immer dunkel, unabhängig vom Erscheinungsbild des Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "従来の不透明な黒いノッチ。Mac の外観にかかわらず常にダークです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존의 불투명한 검정 노치입니다. Mac 모양과 관계없이 항상 어둡게 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная непрозрачная чёрная панель. Всегда тёмная независимо от внешнего вида Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початковий непрозорий чорний виріз. Завжди темний, незалежно від вигляду Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来的不透明黑刘海。无论 Mac 外观如何，始终是深色。"
          }
        }
      }
    },
    "The points where a ring turns amber and red are yours to move, and the weekly ring can be dashed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링이 주황색과 빨간색으로 바뀌는 지점을 직접 조정하고 주간 링을 점선으로 표시할 수 있습니다."
          }
        }
      }
    },
    "The project moved to provider-monitor. Links to the old name still work — GitHub forwards them.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소가 provider-monitor로 옮겼습니다. 예전 이름의 링크도 GitHub이 넘겨주므로 그대로 동작합니다."
          }
        }
      }
    },
    "The repository is named after the app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 이름도 앱 이름을 따릅니다"
          }
        }
      }
    },
    "The ring still follows the main Codex window. Spark and code review stay in the hover card.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングは引き続き Codex のメインウインドウに従います。Spark とコードレビューはホバーカードに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링은 계속 기본 Codex 윈도우를 따릅니다. Spark와 코드 리뷰는 호버 카드에 표시됩니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце й далі стежить за основним вікном ліміту Codex. Spark і перевірка коду лишаються в картці при наведенні."
          }
        }
      }
    },
    "The schedule is maintained locally because it cannot be read reliably from an official API. Times below are UTC; the card converts the next change to your local time.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式 API から確実に読み取れないため、スケジュールはローカルで管理しています。以下の時刻は UTC です。カードでは次の切り替わりが現地時間に変換されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 API에서 안정적으로 읽을 수 없어 일정을 로컬에서 관리합니다. 아래 시간은 UTC이며, 카드에서는 다음 변경 시간을 현지 시간으로 변환합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розклад ведеться локально, бо його не можна надійно прочитати з офіційного API. Час нижче — за UTC; картка переводить наступну зміну у ваш місцевий час."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法可靠地从官方接口读取，这个规则由本地维护。以下时间为 UTC；卡片会将下次切换转换为你的本地时间。"
          }
        }
      }
    },
    "The settings gear is a toggle": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 기어를 토글로 사용"
          }
        }
      }
    },
    "The size the notch was drawn at.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größe, für die die Notch gezeichnet wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille à laquelle l'encoche était dessinée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチが本来描かれるサイズ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치가 설계된 기본 크기입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho com que o notch foi desenhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер, для которого была отрисована панель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір, для якого виріз і малювався."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海绘制时的尺寸。"
          }
        }
      }
    },
    "The sound plays on the ordinary output, not the interface sound-effects channel — so it is still heard with “Play user interface sound effects” switched off in System Settings → Sound.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton wird über die normale Audioausgabe abgespielt, nicht über den Kanal für Bedienklänge — er ist also auch zu hören, wenn „Bedienklänge abspielen“ in Systemeinstellungen → Ton ausgeschaltet ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンドは通常の出力で再生され、インターフェイスの効果音チャンネルは使いません。そのため、システム設定 → サウンドで「ユーザインターフェイスのサウンドエフェクトを再生」をオフにしていても聞こえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사운드는 인터페이스 효과음 채널이 아닌 일반 출력으로 재생됩니다. 따라서 시스템 설정 → 사운드에서 ‘사용자 인터페이스 사운드 효과 재생’을 꺼도 들립니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук відтворюється через звичайний вихід, а не через канал звукових ефектів інтерфейсу — тож його чути навіть тоді, коли «Відтворювати звукові ефекти інтерфейсу» вимкнено в Системних налаштуваннях → Звук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音走普通输出，不是界面音效通道 — 所以在系统设置 → 声音里关掉「播放用户界面声音效果」之后仍然听得见。"
          }
        }
      }
    },
    "The week gets a ring of its own": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Woche bekommt ihren eigenen Ring"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間に専用のリング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 사용량 전용 링"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неделя получает отдельное кольцо"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиждень отримує власне кільце"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周额度有了自己的圆环"
          }
        }
      }
    },
    "The Windows notch now uses the same 70-point body, 44-point rings, spacing, badges and hover-card proportions as the Mac.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 노치가 Mac과 동일한 70포인트 본체, 44포인트 링, 간격, 배지 및 호버 카드 비율을 사용합니다."
          }
        }
      }
    },
    "The Windows app and its installer are named Provider Monitor now — Provider Monitor.exe and Provider-Monitor-Setup.exe.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 앱과 설치 프로그램의 이름을 Provider Monitor로 통일했습니다 — Provider Monitor.exe와 Provider-Monitor-Setup.exe."
          }
        }
      }
    },
    "There is nothing to sign in to: the count is added up from what Gemini CLI, OpenCode and Hermes recorded about their own calls. Your API key is never read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts, wo man sich anmelden müsste: Die Zahl wird aus dem zusammengerechnet, was Gemini CLI, OpenCode und Hermes über ihre eigenen Aufrufe aufgezeichnet haben. Dein API-Schlüssel wird nie gelesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a rien à quoi se connecter : le total est additionné à partir de ce que Gemini CLI, OpenCode et Hermes ont enregistré sur leurs propres appels. Votre clé API n'est jamais lue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインする先はありません。この件数は、Gemini CLI、OpenCode、Hermes が自分の呼び出しについて記録した内容を合算したものです。API キーが読み取られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 항목이 없습니다. Gemini CLI, OpenCode 및 Hermes가 자체 호출에 대해 기록한 수치를 합산합니다. API 키는 읽지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há onde entrar: a contagem é somada a partir do que a CLI do Gemini, o OpenCode e o Hermes registraram sobre as próprias chamadas. Sua chave de API nunca é lida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не требуется: показатель складывается из данных о собственных вызовах Gemini CLI, OpenCode и Hermes. Ваш API-ключ никогда не читается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Входити нікуди: лічильник складається з того, що Gemini CLI, OpenCode і Hermes записали про власні виклики. Ваш API-ключ ніколи не читається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要登录的地方：次数是从 Gemini CLI、OpenCode 和 Hermes 自己记录的调用加总的。不会读取你的 API 密钥。"
          }
        }
      }
    },
    "These have no ring to place. Switch one on and it joins the end of the list above.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese haben keinen Ring zum Platzieren. Schalte eines ein, und es reiht sich am Ende der obigen Liste ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceux-ci n'ont pas d'anneau à placer. Activez-en un et il rejoint la fin de la liste ci-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらには配置するリングがありません。オンにすると、上の一覧の末尾に加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목에는 배치할 링이 없습니다. 항목을 켜면 위 목록의 끝에 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes não têm anel para posicionar. Ative um e ele entra no fim da lista acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этих провайдеров нет кольца. Включите один, и он добавится в конец списка выше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цих немає кільця для розміщення. Увімкніть будь-який — і він стане в кінець списку вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些没有圆环可放。打开其中一个，它会接到上面列表的末尾。"
          }
        }
      }
    },
    "Thinking": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denkt nach"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思考中"
          }
        },
        "ko": {
