          "stringUnit": {
            "state": "translated",
            "value": "即使 Mac 不是这种语言，Provider Monitor 也使用它。"
          }
        }
      }
    },
    "Provider Monitor was refused access to %@'s saved login. Click this ring to ask again, and choose Always Allow.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor wurde der Zugriff auf die gespeicherte Anmeldung von %@ verweigert. Klicke auf diesen Ring, um erneut zu fragen, und wähle „Immer erlauben“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor s'est vu refuser l'accès aux identifiants enregistrés de %@. Cliquez sur cet anneau pour redemander, puis choisissez Toujours autoriser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor は %@ の保存済みログインへのアクセスを拒否されました。このリングをクリックして再度要求し、「常に許可」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor가 %@의 저장된 로그인에 접근하지 못했습니다. 이 링을 클릭해 다시 요청하고 ‘항상 허용’을 선택합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Provider Monitor teve acesso negado ao login salvo do %@. Clique neste anel para pedir de novo e escolha Sempre Permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor не получил доступ к сохранённому входу %@. Нажмите это кольцо, повторите запрос и выберите «Разрешать всегда»."
          }
        },
        "uk": {
          "stringUnit": {
