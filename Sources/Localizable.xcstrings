    "Reads GitHub's Copilot quota endpoint using the GitHub CLI session already on the Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den Copilot-Kontingent-Endpunkt von GitHub über die bereits auf dem Mac vorhandene GitHub-CLI-Sitzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le point de quota Copilot de GitHub en utilisant la session de la CLI GitHub déjà présente sur le Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac にすでにある GitHub CLI のセッションを使って、GitHub の Copilot 割り当てエンドポイントを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 이미 있는 GitHub CLI 세션으로 GitHub의 Copilot 할당량 엔드포인트를 읽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o endpoint de cota do Copilot do GitHub usando a sessão da CLI do GitHub já existente no Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает квоту Copilot через API GitHub, используя уже существующую сессию GitHub CLI на Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає ендпоінт ліміту Copilot у GitHub через сесію GitHub CLI, яка вже є на Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这台 Mac 上已有的 GitHub CLI 会话读取 Copilot 配额接口。"
          }
        }
      }
    },
    "Reads the Go plan's official usage endpoint with the key OpenCode itself stores on sign-in — no second sign-in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den offiziellen Nutzungs-Endpunkt des Go-Tarifs mit dem Schlüssel, den OpenCode selbst bei der Anmeldung speichert — keine zweite Anmeldung nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le point de consommation officiel du plan Go avec la clé qu'OpenCode enregistre lui-même à la connexion — pas de seconde connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode 自身がサインイン時に保存するキーで、Go プランの公式な使用量エンドポイントを読み取ります。二度目のサインインは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode가 로그인할 때 저장한 키로 Go 요금제의 공식 사용량 엔드포인트를 읽으므로 다시 로그인할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o endpoint oficial de uso do plano Go com a chave que o próprio OpenCode guarda ao entrar — sem um segundo login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает официальный API использования тарифа Go с ключом, который OpenCode сохраняет при входе — второй вход не нужен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає офіційний ендпоінт використання тарифу Go з ключем, який OpenCode сам зберігає під час входу — без другого входу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 OpenCode 登录时自己存下的密钥读取 Go 套餐官方用量接口 — 不用再登一次。"
          }
        }
      }
    },
