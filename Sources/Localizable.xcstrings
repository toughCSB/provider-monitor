    "Detected models appear in Accounts → Connected. Model loading and unloading is checked every second.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannte Modelle erscheinen unter Konten → Verbunden. Laden und Entladen von Modellen wird jede Sekunde geprüft."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたモデルは「アカウント」→「接続済み」に表示されます。モデルの読み込みと解放は 1 秒ごとに確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 모델은 계정 → 연결됨에 나타납니다. 모델의 로드 및 언로드 상태를 1초마다 확인합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виявлені моделі зʼявляються в розділі «Акаунти → Підключені». Завантаження та вивантаження моделей перевіряється щосекунди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到的模型会出现在「账号 → 已连接」。模型加载和卸载每秒检查一次。"
          }
        }
      }
    },
    "Deutsch": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutsch"
          }
        }
      }
    },
