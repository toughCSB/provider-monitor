    "Windows now follows the Mac's current design, not its old shell.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Windows판도 예전 골격이 아니라 현재 Mac 디자인을 따릅니다."
          }
        }
      }
    },
    "Windows is Provider Monitor too": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows판도 이제 Provider Monitor입니다"
          }
        }
      }
    },
    "Windows keeps its Claude reading": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows에서 Claude 측정값 유지"
          }
        }
