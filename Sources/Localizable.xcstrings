    "Stays until you have had a chance to look up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt, bis du die Gelegenheit hattest, hinzusehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste jusqu'à ce que vous ayez eu l'occasion de lever les yeux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔を上げる余裕ができるまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 수 있을 때까지 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece até você ter tido a chance de olhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся открытой, пока вы не успеете на неё посмотреть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримається, доки ви не встигнете підвести погляд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会一直留到你有机会抬头看。"
          }
        }
      }
    },
    "Sub-1% usage no longer reads as 0%": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzung unter 1 % wird nicht mehr als 0 % angezeigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une consommation sous 1 % ne se lit plus 0 %"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1% 未満の使用量が 0% と表示されないように"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1% 미만 사용량을 0%로 표시하지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um uso abaixo de 1% não aparece mais como 0%"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование меньше 1% больше не отображается как 0%"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання менше 1% більше не показується як 0%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不到 1% 的用量不再显示成 0%"
          }
        }
      }
    },
