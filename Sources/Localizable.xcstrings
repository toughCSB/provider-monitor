    "Run %@ in Terminal to sign in to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe %@ im Terminal aus, um dich bei %@ anzumelden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をターミナルで実行して %@ にサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal에서 %@을 실행하여 %@에 로그인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите %@ в Терминале, чтобы войти в %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть %@ у Терміналі, щоб увійти в %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端运行 %@ 以登录 %@。"
          }
        }
      }
    },
    "Run `%@` once — it signs in and is what these readings come from. Use /login there to change account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe einmal `%@` aus — das meldet dich an, und daher stammen diese Messwerte. Verwende dort /login, um das Konto zu wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez `%@` une fois — il vous connecte et c'est de là que viennent ces relevés. Utilisez /login là-bas pour changer de compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` を一度実行してください。サインインし、ここでの読み取りはそこから得られます。アカウントを変えるには、そこで /login を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@`을 한 번 실행하면 로그인되며 이 측정값의 출처가 됩니다. 계정을 변경하려면 그곳에서 /login을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute `%@` uma vez — ele faz o login e é a origem destas leituras. Use /login lá para trocar de conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз запустите `%@` — команда выполнит вход и станет источником этих показаний. Для смены аккаунта используйте там /login."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть `%@` один раз — команда виконує вхід, і саме звідти беруться ці показники. Щоб змінити акаунт, введіть там /login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先运行一次 `%@` — 它会登录，读数就来自那里。要换账号，在那里用 /login。"
          }
        }
      }
    },
    "Run `%@` once — it signs in and refreshes the token this reads. Use /login there to change account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe einmal `%@` aus — das meldet dich an und erneuert das hier gelesene Token. Verwende dort /login, um das Konto zu wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez `%@` une fois — il vous connecte et rafraîchit le jeton lu ici. Utilisez /login là-bas pour changer de compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` を一度実行してください。サインインし、ここで読み取るトークンを更新します。アカウントを変えるには、そこで /login を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@`을 한 번 실행하면 로그인하고 이 앱이 읽는 토큰을 갱신합니다. 계정을 변경하려면 그곳에서 /login을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute `%@` uma vez — ele faz o login e renova o token que isto lê. Use /login lá para trocar de conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз запустите `%@` — команда выполнит вход и обновит читаемый токен. Для смены аккаунта используйте там /login."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть `%@` один раз — команда виконує вхід і оновлює токен, який читає Provider Monitor. Щоб змінити акаунт, введіть там /login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先运行一次 `%@` — 它会登录并刷新这里读取的令牌。要换账号，在那里用 /login。"
          }
        }
      }
    },
    "Run `devin auth login` in a terminal to sign in.": {
