    "Displays a notification card from the side of the notch when a provider's session or weekly usage limit is reached.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスのセッションまたは週間の使用量が上限に達したとき、ノッチの横から通知カードを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로바이더의 세션 또는 주간 사용량 한도에 도달하면 노치 옆에 알림 카드를 표시합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує картку сповіщення збоку від вирізу, коли досягнуто сесійний або тижневий ліміт провайдера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某家服务的会话或周额度用尽时，刘海侧面滑出一张通知卡片。"
          }
        }
      }
    },
    "Displays a notification card from the side of the notch when a provider's usage limit resets.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスの使用量の上限がリセットされたとき、ノッチの横から通知カードを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로바이더의 사용량 한도가 재설정되면 노치 옆에 알림 카드를 표시합니다."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує картку сповіщення збоку від вирізу, коли ліміт провайдера скидається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某家服务的额度窗口滚动过后，刘海侧面滑出一张通知卡片。"
          }
        }
      }
    },
    "Distant resets show a date": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weit entfernte Zurücksetzungen zeigen ein Datum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réinitialisations lointaines affichent une date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先のリセットは日付で表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼 재설정은 날짜로 표시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovações distantes exibem uma data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далёкий сброс показывает дату"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далекі скидання показують дату"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很远的重置会显示日期"
          }
        }
      }
    },
    "Dock": {
