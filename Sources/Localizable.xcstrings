    "Provider Monitor uses this language even if the Mac does not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor verwendet diese Sprache, auch wenn der Mac es nicht tut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor utilise cette langue même si le Mac ne le fait pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac がこの言語でなくても、Provider Monitor はこの言語を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 언어와 관계없이 Provider Monitor가 이 언어를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Provider Monitor usa este idioma mesmo que o Mac não use."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor использует этот язык независимо от языка Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor використовує цю мову, навіть якщо в системі вибрано іншу."
          }
        },
