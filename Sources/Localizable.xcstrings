    "Switch accounts in %@; the notch follows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto in %@ wechseln; die Notch folgt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de compte dans %@ ; l'encoche suit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でアカウントを切り替えると、ノッチもそれに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 계정을 전환하면 노치도 따라갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque de conta no %@; o notch acompanha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените аккаунт в %@ — выемка обновится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть акаунт у %@ — виріз оновиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 里切换账号，刘海会跟上。"
          }
        }
      }
    },
    "Switch accounts in the tool that owns it; the notch follows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto in dem Tool wechseln, dem es gehört; die Notch folgt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de compte dans l'outil qui le détient ; l'encoche suit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアカウントを持つツールで切り替えると、ノッチもそれに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 보유한 도구에서 계정을 전환하면 노치도 따라갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque de conta na ferramenta dona dela; o notch acompanha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените аккаунт в приложении, которому он принадлежит — выемка обновится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть акаунт в інструменті, якому він належить, — виріз оновиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在持有该账号的工具里切换，刘海会跟上。"
          }
        }
      }
    },
    "Switch off to stop reading %@ and forget its readings. %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten, um %@ nicht mehr zu lesen und dessen Messwerte zu vergessen. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour arrêter de lire %@ et oublier ses relevés. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると %@ の読み取りを止め、その読み取りを忘れます。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 %@ 읽기를 중단하고 측정값을 삭제합니다. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para parar de ler o %@ e esquecer suas leituras. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы прекратить чтение %@ и удалить его показания. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть, щоб припинити читати %@ і забути його показники. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后停止读取 %@ 并忘掉它的读数。%@"
          }
        }
      }
    },
    "Switch on to sign in and read %@ again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, um dich anzumelden und %@ wieder zu lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez pour vous reconnecter et lire %@ à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると再びサインインして %@ を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 로그인하여 %@을 다시 읽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para entrar e ler o %@ de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы снова войти и читать %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть, щоб знову увійти й читати %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开以重新登录并读取 %@。"
          }
        }
      }
    },
    "Switch this on to give it a ring in the notch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das ein, um ihm einen Ring in der Notch zu geben."
