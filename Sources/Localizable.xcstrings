    "%@ usage needs its sign-in renewed — run `claude` once in a terminal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung für die %@-Nutzung muss erneuert werden — führe einmal `claude` in einem Terminal aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の使用量はサインインの更新が必要です — ターミナルで `claude` を一度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사용량을 읽으려면 로그인을 갱신해야 합니다. 터미널에서 `claude`를 한 번 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для использования %@ нужно обновить вход — один раз запустите `claude` в терминале."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб читати використання %@, потрібно поновити вхід — запустіть `claude` один раз у терміналі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用量需要重新登录 — 在终端里运行一次 `claude`。"
          }
        }
      }
    },
