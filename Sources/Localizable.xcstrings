          }
        }
      }
    },
    "Codenotch uses this language even if the Mac does not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch verwendet diese Sprache, auch wenn der Mac es nicht tut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch utilise cette langue même si le Mac ne le fait pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac がこの言語でなくても、Codenotch はこの言語を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 언어와 관계없이 Provider Monitor가 이 언어를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codenotch usa este idioma mesmo que o Mac não use."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch использует этот язык независимо от языка Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch використовує цю мову, навіть якщо в системі вибрано іншу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 Mac 不是这种语言，Codenotch 也使用它。"
          }
        }
      }
    },
    "Codenotch was refused access to %@'s saved login. Click this ring to ask again, and choose Always Allow.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch wurde der Zugriff auf die gespeicherte Anmeldung von %@ verweigert. Klicke auf diesen Ring, um erneut zu fragen, und wähle „Immer erlauben“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch s'est vu refuser l'accès aux identifiants enregistrés de %@. Cliquez sur cet anneau pour redemander, puis choisissez Toujours autoriser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch は %@ の保存済みログインへのアクセスを拒否されました。このリングをクリックして再度要求し、「常に許可」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor가 %@의 저장된 로그인에 접근하지 못했습니다. 이 링을 클릭해 다시 요청하고 ‘항상 허용’을 선택합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codenotch teve acesso negado ao login salvo do %@. Clique neste anel para pedir de novo e escolha Sempre Permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch не получил доступ к сохранённому входу %@. Нажмите это кольцо, повторите запрос и выберите «Разрешать всегда»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch не отримав доступу до збереженого входу %@. Натисніть це кільце, щоб запитати знову, і виберіть «Завжди дозволяти»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch 未能读取 %@ 已保存的登录信息。点击这个圆环再试一次，并选择「始终允许」。"
          }
        }
      }
    },
    "Codex is read live instead of from a log": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex wird live gelesen statt aus einem Protokoll"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex est lu en direct plutôt que depuis un journal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex をログではなくライブで読み取るように"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 대신 Codex 실시간 측정"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex é lido ao vivo em vez de a partir de um registro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex читается в реальном времени, а не из журнала"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex читається наживо, а не з журналу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 改为实时读取，而不再读日志"
          }
        }
      }
    },
    "Codex reads live, and Always show stays on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex liest live, und „Immer anzeigen“ bleibt an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex se lit en direct, et Toujours afficher le reste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex をライブ読み取りに。「常に表示」もオフになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 실시간 측정 및 ‘항상 표시’ 유지."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex é lido ao vivo, e o Sempre exibir permanece ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex читается в реальном времени, а «Показывать всегда» сохраняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex читається наживо, а «Показувати завжди» лишається увімкненим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 改为实时读取，「始终显示」会保持打开。"
          }
        }
      }
    },
    "Codex reported no usage windows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex hat keine Nutzungsfenster gemeldet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex n'a signalé aucune fenêtre de consommation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex は使用量の枠を返しませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex가 사용량 기간을 보고하지 않았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex não informou nenhuma janela de uso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex не сообщил ни одного окна использования"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex не повернув жодного вікна використання"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 没有返回任何用量窗口"
          }
        }
      }
    },
    "Codex sessions are read from the end of the file instead of all of it, the Codex card hides an empty reset-credits section, and a Claude token on Windows that fails to renew is retried instead of freezing the card.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 세션 파일은 전체가 아닌 끝부분부터 읽고, Codex 카드에서 빈 재설정 크레딧 섹션을 숨깁니다. Windows에서 Claude 토큰 갱신에 실패하면 카드가 멈추지 않고 다시 시도합니다."
          }
        }
      }
    },
    "Codex's extra limits": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 추가 한도"
          }
        }
      }
    },
    "Codex's live reading only recognised a 5-hour and a 7-day window. A free-plan account's real limit was a 30-day one, which fell through unnoticed and showed as nothing metered on an account that was genuinely tracked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex' Live-Messwert erkannte nur ein 5-Stunden- und ein 7-Tage-Fenster. Das tatsächliche Limit eines Kontos mit kostenlosem Tarif war ein 30-Tage-Limit, das unbemerkt durchrutschte und bei einem eigentlich erfassten Konto als „nichts zu messen“ angezeigt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relevé en direct de Codex ne reconnaissait qu'une fenêtre de 5 heures et une de 7 jours. La vraie limite d'un compte en plan gratuit était sur 30 jours : elle passait inaperçue et s'affichait comme « rien à mesurer » sur un compte pourtant bien suivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex のライブ読み取りは 5 時間と 7 日間の枠しか認識していませんでした。無料プランのアカウントの実際の上限は 30 日間で、これが見落とされ、本当は計測されているアカウントが「計測対象なし」と表示されていました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 실시간 측정이 5시간 및 7일 기간만 인식했습니다. 무료 요금제 계정의 실제 30일 한도가 누락되어, 추적 중인 계정인데도 측정 항목이 없는 것으로 표시되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura ao vivo do Codex só reconhecia uma janela de 5 horas e uma de 7 dias. O limite real de uma conta do plano gratuito era de 30 dias, que passava despercebido e aparecia como nada medido numa conta que de fato era acompanhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуальное чтение Codex распознавало только окна на 5 часов и 7 дней. У бесплатного аккаунта настоящим был лимит на 30 дней, который незаметно пропускался, поэтому отслеживаемый аккаунт показывался без измеряемого использования."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання Codex наживо розпізнавало лише вікна на 5 годин і 7 днів. Справжнім лімітом акаунта на безкоштовному тарифі було 30-денне вікно, яке непомітно провалювалося, тож акаунт, за яким облік справді вівся, показувався як такий, де нічого не вимірюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 的实时读数只认 5 小时和 7 天窗口。免费套餐账号真正的额度是 30 天，被悄悄漏掉，一个确实在计量的账号显示成没有可计量的额度。"
          }
        }
      }
    },
    "Command Code has nothing metered on this account yet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code hat für dieses Konto noch nichts zu messen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code n'a encore rien de mesuré sur ce compte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには、Command Code が計測する対象がまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Command Code 계정에는 아직 측정된 항목이 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Command Code ainda não tem nada medido nesta conta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого аккаунта Command Code пока нет измеряемого использования"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому акаунті Command Code поки нічого не вимірює"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Command Code 账号目前没有可计量的额度"
          }
        }
      }
    },
    "Compares each timed allowance with the time left until reset, showing quota in deficit or held in reserve.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht jedes zeitgebundene Kontingent mit der bis zur Zurücksetzung verbleibenden Zeit und zeigt, ob ein Kontingent im Defizit oder in Reserve ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare chaque allocation temporisée au temps restant avant réinitialisation, en montrant le quota en déficit ou gardé en réserve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間で区切られた枠ごとに、リセットまでの残り時間と比べて、超過分か余裕分かを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간제한이 있는 각 할당량을 재설정까지 남은 시간과 비교하여 부족분 또는 여유분을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara cada cota cronometrada com o tempo restante até a renovação, mostrando a cota em déficit ou guardada em reserva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает каждый лимит по времени с оставшимся до сброса временем и показывает дефицит или запас квоты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівнює кожен часовий ліміт із часом, що лишився до скидання, і показує, де ліміт у дефіциті, а де в запасі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每段有时限的额度与距离重置的时间比较，显示透支还是留有余量。"
          }
        }
      }
    },
