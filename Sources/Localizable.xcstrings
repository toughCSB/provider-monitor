    "Nothing is connected, so the notch has no rings to draw.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist verbunden, daher hat die Notch keine Ringe zu zeichnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est connecté : l'encoche n'a donc aucun anneau à dessiner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も接続されていないため、ノッチに描くリングがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 항목이 없어 노치에 표시할 링이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está conectado, então o notch não tem anéis para desenhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не подключено, поэтому панели нечего отображать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не підключено, тож вирізу немає чого малювати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已连接的服务，刘海里没有圆环可画。"
          }
        }
      }
    },
    "Nothing on screen. Open Codenotch again from Applications to bring these settings back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts auf dem Bildschirm. Öffne Codenotch erneut aus dem Programme-Ordner, um diese Einstellungen zurückzuholen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à l'écran. Rouvrez Codenotch depuis Applications pour retrouver ces réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面には何も出ません。この設定に戻るには、アプリケーションから Codenotch をもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 아무것도 표시하지 않습니다. 이 설정을 다시 열려면 응용 프로그램에서 Provider Monitor를 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada na tela. Abra o Codenotch novamente em Aplicativos para trazer estes ajustes de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не показывать. Откройте Codenotch снова из Программ, чтобы вернуть эти настройки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого на екрані. Відкрийте Codenotch знову з теки «Програми», щоб повернути ці налаштування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上什么都没有。从「应用程序」再打开 Codenotch，才能回到这些设置。"
          }
        }
      }
    },
