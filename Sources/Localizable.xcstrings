    },
    "Enter an Ollama API key in Settings, or export OLLAMA_API_KEY": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib in den Einstellungen einen Ollama-API-Schlüssel ein oder exportiere OLLAMA_API_KEY"
          }
        },
