          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider Monitor 설정"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes do Codenotch"
          }
        },
        "ru": {
